{
  "name": "app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "db:push": "dotenv -e .env.local -- drizzle-kit push --force",
    "db:studio": "dotenv -e .env.local -- drizzle-kit studio",
    "seed": "dotenv -e .env.local -- tsx scripts/seed.ts",
    "qa:dev": "node .claude/scripts/qa-env.mjs next dev -p 3010",
    "qa:sql": "node .claude/scripts/qa-env.mjs npm run -s sql --",
    "qa:seed": "node .claude/scripts/qa-env.mjs tsx scripts/seed.ts",
    "check": "npm run typecheck && npm run lint && npm run test",
    "format": "prettier --write .",
    "test:int": "dotenv -e .env.local -- env VITEST_INT=1 vitest run",
    "sql": "dotenv -e .env.local -- tsx scripts/sql.ts",
    "worker": "dotenv -e .env.local -- tsx --conditions=react-server scripts/worker.ts"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.57",
    "@ai-sdk/google": "^4.0.75",
    "@ai-sdk/openai": "^4.0.70",
    "@anthropic-ai/claude-agent-sdk": "^0.3.278",
    "@base-ui/react": "^1.8.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@neondatabase/serverless": "^1.1.0",
    "ai": "^7.0.106",
    "better-auth": "^1.7.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.3.0",
    "cron-parser": "^5.10.1",
    "csv-parse": "^7.0.2",
    "drizzle-orm": "^0.45.2",
    "exceljs": "^4.4.0",
    "lucide-react": "^1.47.0",
    "next": "16.3.5",
    "next-themes": "^0.4.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "shadcn": "^4.21.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "vega": "^6.4.0",
    "vega-lite": "^6.4.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24.13.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.1",
    "dotenv-cli": "^11.0.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "prettier": "^3.9.8",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5",
    "vitest": "^5.0.1"
  }
}
