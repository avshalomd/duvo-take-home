# Neon Postgres (provisioned with `vercel integration add neon`, pulled with `vercel env pull .env.local`)
DATABASE_URL=
# LLM: set ONE provider key, or rely on the Vercel AI Gateway via VERCEL_OIDC_TOKEN from `vercel env pull`
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
OPENROUTER_API_KEY=
# Optional: override the model and its fallback without a code change (src/lib/ai.ts, .claude/docs/models.md).
# Left commented on purpose: AI_MODEL_FALLBACK set to nothing switches the fallback OFF.
# AI_MODEL=
# AI_MODEL_FALLBACK=
# Optional, the decision model behind decide() (src/lib/llm/decide.ts). Without it decide() uses OPENROUTER_API_KEY,
# then the AI Gateway. JEV_MODEL pins a model id and with it a single route.
TYPESAFE_API_KEY=
# JEV_MODEL=
