# Neon Postgres (provisioned with `vercel integration add neon`, pulled with `vercel env pull .env.local`)
DATABASE_URL=
# LLM: set ONE provider key, or rely on the Vercel AI Gateway via VERCEL_OIDC_TOKEN from `vercel env pull`
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
OPENROUTER_API_KEY=
# Optional: override the model and its fallback without a code change (src/lib/ai.ts, .claude/docs/models.md).
# Left commented on purpose: AI_MODEL_FALLBACK set to nothing switches the fallback OFF.
# AI_MODEL=
# AI_MODEL_FALLBACK=
# Optional, the decision model behind decide() (src/lib/llm/decide.ts). Without it decide() uses OPENROUTER_API_KEY,
# then the AI Gateway. JEV_MODEL pins a model id and with it a single route.
TYPESAFE_API_KEY=
# JEV_MODEL=

# v2: sign-in (Better Auth). The secret signs sessions: 32 random bytes, base64 (openssl rand -base64 32).
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
# Optional: "Continue with Google" appears only when both are set.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# v2: connection tokens and OAuth tokens are encrypted at rest with this key (32 random bytes, base64).
CONNECTION_KEY=
# v2: how runs execute. inline (default) runs in the request; queue needs `npm run worker` beside the app;
# route (on Vercel) runs each one in /api/runner/<id>, the only function that carries the agent's binary.
# RUNNER=inline
# WORKER_CONCURRENCY=2
# v2: schedules fire from the worker, or from GET /api/cron/tick with this bearer secret.
# CRON_SECRET=
# Optional: what the whole deployment may spend on runs in a UTC day, across every workspace (default 50).
# DEPLOYMENT_DAILY_BUDGET_USD=50
# Local only: the seeded demo user's password (demo@example.com).
# DEMO_PASSWORD=demo-password
