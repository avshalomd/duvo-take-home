{
  "permissions": {
    "allow": [
      "Bash(npm:*)",
      "Bash(npx:*)",
      "Bash(node:*)",
      "Bash(git:*)",
      "Bash(gh:*)",
      "Bash(vercel:*)",
      "Bash(curl:*)",
      "Bash(.claude/scripts/clock-start.sh:*)",
      "Bash(.claude/scripts/gate.sh:*)",
      "Bash(.claude/scripts/scaffold.sh:*)",
      "Bash(.claude/scripts/deploy.sh:*)",
      "Bash(.claude/scripts/wt-setup.sh:*)",
      "Bash(.claude/scripts/wt-serve.sh:*)",
      "Bash(ls:*)",
      "Bash(mkdir:*)",
      "Bash(grep:*)",
      "Bash(lsof:*)",
      "Bash(kill:*)",
      "Edit",
      "Write",
      "WebFetch",
      "WebSearch",
      "Bash(rsync:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/.env.*.local)",
      "Read(**/.env.production)",
      "Read(**/.env.development)",
      "Bash(cat .env*)"
    ]
  },
  "enabledPlugins": {
    "superpowers@claude-plugins-official": false,
    "sporhund@sporhund": false,
    "playwright@claude-plugins-official": false
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-secrets.sh\""
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/clock.sh\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/clock-tick.sh\""
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/statusline.sh\""
  },
  "disableClaudeAiConnectors": true,
  "worktree": {
    "baseRef": "head"
  }
}
